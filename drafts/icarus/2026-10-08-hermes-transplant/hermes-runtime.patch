+
+parser=argparse.ArgumentParser()
+parser.add_argument('--repository', type=Path, required=True, help='Owner-supplied Teamchat checkout')
+parser.add_argument('--profile', type=Path, required=True, help='Protected profile, read only')
+parser.add_argument('--runtime-source', type=Path, required=True, help='Patched isolated donor checkout')
+args=parser.parse_args()
+target=args.runtime_source.resolve()/'agent'/'icarus_lineage'
+if target.exists(): raise SystemExit('Existing canonical lineage preserved. Import only into a new isolated candidate.')
+inputs={name:args.repository/'icarus'/'memory'/name for name in ('identity.md','inherited.md','learned.md','current-state.md')}
+inputs['training.md']=args.repository/'TRAINING_MATRIX.md'
+for folder in ('generational-memory','skills'):
+    for path in (args.profile/folder).rglob('*'):
+        if path.is_file() and not path.is_symlink() and path.suffix in ('.md','.json','.yaml','.yml','.csv','.txt'):
+            inputs[str(path.relative_to(args.profile)).replace('\\','/')]=path
+def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+before={name:sha(path) for name,path in inputs.items()}
+commit=subprocess.check_output(['git','rev-parse','HEAD'],cwd=args.repository,text=True).strip()
+manifest=dict(schema=1,repository='owner-supplied-local-checkout',commit=commit,
+    donor='99a45ecc17cc51c0488ec3b8ccf7eaf483f7203d',files=before,sources={})
+target.mkdir(parents=True)
+for name,path in inputs.items():
+    destination=target/name
+    destination.parent.mkdir(parents=True,exist_ok=True)
+    shutil.copy2(path,destination)
+    if sha(destination)!=before[name] or sha(path)!=before[name]:
+        raise SystemExit('Canonical input changed; preserve incomplete import and do not launch.')
+    manifest['sources'][name]=dict(kind='dated-local-snapshot',source=str(path.resolve()),verified_current_capability=False)
+(target/'manifest.json').write_text(json.dumps(manifest,indent=2),encoding='utf-8')
+print('Local canonical snapshots imported:',len(inputs))
