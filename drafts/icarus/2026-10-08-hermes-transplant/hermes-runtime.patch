diff --git a/agent/icarus_authority.py b/agent/icarus_authority.py
new file mode 100644
--- /dev/null
+++ b/agent/icarus_authority.py
@@ -0,0 +1,246 @@
+"""Native ICARUS permit kernel. Port of the existing GovernanceKernel v1 contract.
+
+Trusted host code owns issuance. Model programs have no host/source/key mounts.
+This module does not claim to sandbox Python plugins loaded by an administrator.
+"""
+from __future__ import annotations
+
+import contextlib
+import contextvars
+import hashlib
+import hmac
+import json
+import secrets
+import sqlite3
+import threading
+import time
+from pathlib import Path
+
+POLICY = "icarus.hermes.v1"
+_ACTIVE = contextvars.ContextVar("icarus_active_permit", default=None)
+_RUNTIME = contextvars.ContextVar("icarus_runtime", default=None)
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
+
+
+def digest(value):
+    return hashlib.sha256(canonical(value).encode()).hexdigest()
+
+
+class AuthorityDenied(PermissionError):
+    """No adapter may execute following this failure."""
+
+
+class PermitKernel:
+    def __init__(self, db_path: Path, identity_hash: str):
+        self.db_path = Path(db_path)
+        self.identity_hash = identity_hash
+        self.db_path.parent.mkdir(parents=True, exist_ok=True)
+        with self.connect() as db:
+            db.executescript("""
+                CREATE TABLE IF NOT EXISTS icarus_seal (id INTEGER PRIMARY KEY CHECK(id=1), key TEXT NOT NULL);
+                CREATE TABLE IF NOT EXISTS icarus_permits
+                (nonce TEXT PRIMARY KEY, payload TEXT NOT NULL, signature TEXT NOT NULL,
+                 state TEXT NOT NULL, result_hash TEXT);
+                CREATE TABLE IF NOT EXISTS icarus_events
+                (seq INTEGER PRIMARY KEY, record TEXT NOT NULL, previous TEXT NOT NULL, seal TEXT NOT NULL);
+                CREATE TABLE IF NOT EXISTS icarus_calls
+                (call_key TEXT PRIMARY KEY, nonce TEXT UNIQUE NOT NULL);
+                CREATE TABLE IF NOT EXISTS icarus_containers
+                (nonce TEXT PRIMARY KEY, container TEXT NOT NULL);
+            """)
+            db.execute("INSERT OR IGNORE INTO icarus_seal VALUES(1,?)", (secrets.token_hex(32),))
+            self._key = bytes.fromhex(db.execute("SELECT key FROM icarus_seal WHERE id=1").fetchone()[0])
+            self._check_history(db)
+
+    def connect(self):
+        db = sqlite3.connect(self.db_path, timeout=10)
+        db.execute("PRAGMA busy_timeout=10000")
+        return db
+
+    def _mac(self, value):
+        return hmac.new(self._key, canonical(value).encode(), hashlib.sha256).hexdigest()
+
+    def _check_history(self, db):
+        previous = ""
+        for index, row in enumerate(db.execute("SELECT seq,record,previous,seal FROM icarus_events ORDER BY seq"), 1):
+            seq, record, stored_previous, seal = row
+            if seq != index or stored_previous != previous or not hmac.compare_digest(seal, self._mac([seq, record, previous])):
+                raise AuthorityDenied("ICARUS audit integrity failure")
+            previous = seal
+        return previous
+
+    def _event(self, db, event, nonce, **fields):
+        previous = self._check_history(db)
+        seq = db.execute("SELECT COALESCE(MAX(seq),0)+1 FROM icarus_events").fetchone()[0]
+        record = canonical(dict(event=event, nonce=nonce, utc=time.time(), **fields))
+        seal = self._mac([seq, record, previous])
+        db.execute("INSERT INTO icarus_events VALUES(?,?,?,?)", (seq, record, previous, seal))
+
+    def prepare(self, spec, *, ttl=300):
+        """Host-only issuance AFTER runtime policy validation, never a model tool."""
+        if not isinstance(ttl, (int, float)) or not 0 < ttl <= 300:
+            raise AuthorityDenied("ICARUS invalid permit lifetime")
+        fields = {"session", "task", "objectiveHash", "revision", "call", "subject", "tool", "argsHash", "target", "route", "scopes", "budgetEUR", "evidence"}
+        if not isinstance(spec, dict) or set(spec) != fields:
+            raise AuthorityDenied("ICARUS malformed preflight contract")
+        if spec.get("budgetEUR") != 0 or not all(spec.get(k) for k in fields - {"budgetEUR"}):
+            raise AuthorityDenied("ICARUS missing preflight identity or zero-cost contract")
+        payload = dict(spec=spec, nonce=secrets.token_hex(24), expiry=time.time()+ttl,
+                       policy=POLICY, identity=self.identity_hash)
+        permit = dict(payload=payload, signature=self._mac(payload))
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            call_key = digest([spec[k] for k in ("session", "task", "revision", "call")])
+            if db.execute("SELECT nonce FROM icarus_calls WHERE call_key=?", (call_key,)).fetchone():
+                raise AuthorityDenied("ICARUS duplicate logical call denied")
+            db.execute("INSERT INTO icarus_calls VALUES(?,?)", (call_key, payload["nonce"]))
+            self._event(db, "permit.issued", payload["nonce"], request=digest(spec))
+            db.execute("INSERT INTO icarus_permits VALUES(?,?,?,'READY',NULL)",
+                       (payload["nonce"], canonical(payload), permit["signature"]))
+        return permit
+
+    def consume(self, permit, spec):
+        payload = permit.get("payload") if isinstance(permit, dict) else None
+        signature = permit.get("signature") if isinstance(permit, dict) else None
+        if not isinstance(payload, dict) or not isinstance(signature, str) or not hmac.compare_digest(signature, self._mac(payload)):
+            raise AuthorityDenied("ICARUS missing or forged permit")
+        if payload.get("policy") != POLICY or payload.get("identity") != self.identity_hash:
+            raise AuthorityDenied("ICARUS authority version mismatch")
+        if payload.get("expiry", 0) <= time.time():
+            raise AuthorityDenied("ICARUS expired permit")
+        if canonical(payload.get("spec")) != canonical(spec):
+            raise AuthorityDenied("ICARUS altered execution request")
+        nonce = payload.get("nonce")
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            self._check_history(db)
+            task_table = db.execute("SELECT name FROM sqlite_master WHERE name='icarus_tasks'").fetchone()
+            if task_table:
+                task = db.execute("SELECT objective,revision FROM icarus_tasks WHERE session=? AND task=?",
+                                  (spec["session"], spec["task"])).fetchone()
+                if task != (spec["objectiveHash"], spec["revision"]):
+                    raise AuthorityDenied("ICARUS objective changed; new preflight required")
+            row = db.execute("SELECT payload,signature,state FROM icarus_permits WHERE nonce=?", (nonce,)).fetchone()
+            if row != (canonical(payload), signature, "READY"):
+                raise AuthorityDenied("ICARUS replay or unknown permit")
+            db.execute("UPDATE icarus_permits SET state='WORKING' WHERE nonce=?", (nonce,))
+            self._event(db, "gateway.intent.persisted", nonce, request=digest(spec))
+        return nonce
+
+    def record_outcome(self, nonce, result=None, *, uncertain=False):
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            state = "OUTCOME_UNKNOWN" if uncertain else "WORK_COMPLETE_AWAITING_VERIFICATION"
+            changed = db.execute("UPDATE icarus_permits SET state=?,result_hash=? WHERE nonce=? AND state IN ('WORKING','ADAPTER_ENTERED')",
+                                 (state, None if uncertain else digest(result), nonce)).rowcount
+            if changed != 1:
+                raise AuthorityDenied("ICARUS execution state mismatch")
+            self._event(db, "execution.outcome", nonce, state=state)
+
+    def adjudicate(self, nonce):
+        """Trusted host-only observation AFTER the worker turn; no supplied evidence."""
+        if _ACTIVE.get() is not None or _RUNTIME.get() is not None:
+            raise AuthorityDenied("ICARUS worker-turn self-certification denied")
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            self._check_history(db)
+            row = db.execute("SELECT state,payload FROM icarus_permits WHERE nonce=?", (nonce,)).fetchone()
+            if not row or row[0] != "WORK_COMPLETE_AWAITING_VERIFICATION":
+                raise AuthorityDenied("ICARUS verification state denied")
+            spec = json.loads(row[1])["spec"]
+            contract = spec["evidence"]
+            from agent.icarus_verifier import observe
+            observed_hash, read_ref = observe(self, spec, nonce)
+            if not contract.get("expectedHash") or contract["expectedHash"] != observed_hash or contract["readPath"] != read_ref:
+                raise AuthorityDenied("ICARUS physical target does not satisfy evidence contract")
+            db.execute("UPDATE icarus_permits SET state='PASS' WHERE nonce=?", (nonce,))
+            self._event(db, "verification.completed", nonce, verifier="icarus-trusted-target-reader", observed=observed_hash, read_ref=read_ref)
+            return "PASS"
+
+
+@contextlib.contextmanager
+def runtime_scope(runtime):
+    token = _RUNTIME.set(runtime)
+    try:
+        yield
+    finally:
+        _RUNTIME.reset(token)
+
+
+@contextlib.contextmanager
+def adapter_scope(kernel, nonce, spec):
+    # A capability authorizes exactly one registry entry. Nested dispatch must
+    # obtain its own permit; matching the parent tool name is not authority.
+    with kernel.connect() as db:
+        row = db.execute("SELECT payload,signature,state FROM icarus_permits WHERE nonce=?", (nonce,)).fetchone()
+        if not row or row[2] != "WORKING":
+            raise AuthorityDenied("ICARUS consumed durable permit required")
+        payload = json.loads(row[0])
+        if canonical(payload["spec"]) != canonical(spec) or not hmac.compare_digest(row[1], kernel._mac(payload)):
+            raise AuthorityDenied("ICARUS altered adapter scope denied")
+    context = dict(kernel=kernel, nonce=nonce, spec=spec, entered=False, lock=threading.Lock())
+    token = _ACTIVE.set(context)
+    try:
+        yield
+    finally:
+        _ACTIVE.reset(token)
+
+
+def _check_route(spec, task_id, session_id):
+    if (task_id is not None and task_id != spec["task"]) or (session_id is not None and session_id != spec["session"]):
+        raise AuthorityDenied("ICARUS adapter task/session route mismatch")
+    return spec
+
+
+def require_adapter(name, args, *, task_id=None, session_id=None):
+    active = _ACTIVE.get()
+    if active is None:
+        raise AuthorityDenied("ICARUS direct, altered or nested adapter execution denied")
+    with active["lock"]:
+        _check_route(active["spec"], task_id, session_id)
+        if active["entered"] or active["spec"]["tool"] != name or active["spec"]["argsHash"] != digest(args):
+            raise AuthorityDenied("ICARUS direct, altered or nested adapter execution denied")
+        kernel = active["kernel"]
+        with kernel.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            kernel._check_history(db)
+            row = db.execute("SELECT payload,state FROM icarus_permits WHERE nonce=?", (active["nonce"],)).fetchone()
+            if not row or row[1] != "WORKING" or json.loads(row[0])["expiry"] <= time.time():
+                raise AuthorityDenied("ICARUS adapter replay/expired admission denied")
+            db.execute("UPDATE icarus_permits SET state='ADAPTER_ENTERED' WHERE nonce=?", (active["nonce"],))
+            kernel._event(db, "adapter.entered", active["nonce"], tool=name)
+        active["entered"] = True
+        return active["spec"]
+
+
+def check_adapter(name, args, *, task_id=None, session_id=None):
+    """Check forwarding seams without consuming the single final entry."""
+    active = _ACTIVE.get()
+    if active is None or active["entered"] or active["spec"]["tool"] != name or active["spec"]["argsHash"] != digest(args):
+        raise AuthorityDenied("ICARUS direct, altered or nested tool request denied")
+    return _check_route(active["spec"], task_id, session_id)
+
+
+def current_runtime():
+    runtime = _RUNTIME.get()
+    if runtime is None:
+        raise AuthorityDenied("ICARUS runtime authority missing")
+    return runtime
+
+
+def bind_container_target(container):
+    active = _ACTIVE.get()
+    if active is None or not active["entered"] or not container:
+        raise AuthorityDenied("ICARUS container target requires admitted execution")
+    kernel = active["kernel"]
+    with kernel.connect() as db:
+        db.execute("BEGIN IMMEDIATE")
+        row = db.execute("SELECT container FROM icarus_containers WHERE nonce=?", (active["nonce"],)).fetchone()
+        if row and row[0] != container:
+            raise AuthorityDenied("ICARUS target changed after admission")
+        if not row:
+            db.execute("INSERT INTO icarus_containers VALUES(?,?)", (active["nonce"], container))
+            kernel._event(db, "target.bound", active["nonce"], container=container)
diff --git a/agent/icarus_hooks.py b/agent/icarus_hooks.py
new file mode 100644
--- /dev/null
+++ b/agent/icarus_hooks.py
@@ -0,0 +1,37 @@
+"""Mandatory ICARUS configured hooks, enforced independently of plugin hooks."""
+import hashlib, json, subprocess, sys
+from pathlib import Path
+from utils import fast_safe_load
+from agent.icarus_authority import AuthorityDenied
+
+def invoke(runtime, event, spec, nonce, args):
+    config = fast_safe_load((runtime.home / "config.yaml").read_text(encoding="utf-8"))
+    policy = config.get("icarus", {})
+    if policy.get("active") is not True:
+        raise AuthorityDenied("ICARUS mandatory governance configuration missing")
+    # Validate both lifecycle declarations BEFORE any adapter effect.
+    for required in ("pre_tool_call", "post_tool_call"):
+        items = config.get("hooks", {}).get(required)
+        if not isinstance(items, list) or len(items) != 1:
+            raise AuthorityDenied("ICARUS mandatory hook configuration missing")
+        item = items[0]
+        if item.get("command") != "governance/icarus_hook.py" or item.get("fail_closed") is not True:
+            raise AuthorityDenied("ICARUS hook configuration altered")
+        timeout = item.get("timeout", 6)
+        if type(timeout) not in (int, float) or not 0 < timeout <= 10:
+            raise AuthorityDenied("ICARUS invalid bounded hook timeout")
+    item = config["hooks"][event][0]
+    for name in ("icarus_hook.py", "icarus_governance.py"):
+        path = runtime.home / "governance" / name
+        expected = policy.get("governance_hashes", {}).get(name)
+        if not expected or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
+            raise AuthorityDenied("ICARUS governance hook integrity failure")
+    payload = dict(hook_event_name=event, session_id=spec["session"], tool_name=spec["tool"],
+                   tool_input=args, extra=dict(task_id=spec["task"], tool_call_id=spec["call"], icarus_nonce=nonce))
+    result = subprocess.run([sys.executable, "-B", str(runtime.home / "governance" / "icarus_hook.py")],
+                            input=json.dumps(payload), text=True, encoding="utf-8", capture_output=True,
+                            cwd=runtime.home, timeout=min(float(item.get("timeout", 6)), 10),
+                            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+    wanted = {"action":"allow"} if event == "pre_tool_call" else {}
+    if result.returncode or json.loads(result.stdout) != wanted:
+        raise AuthorityDenied("ICARUS governance hook denied execution/observation")
