+    result = first.run_conversation("Finish the proof task", task_id="same-task")
+    assert result["icarus"]["name"] == "Icarus"
+    assert result["icarus"]["task"] == "same-task"
+    target = first._todo_store.read()
+    assert target == [{"id": "proof", "content": "native target", "status": "completed"}]
+    chats = [request for request in requests if "messages" in request]
+    assert "The model is never Icarus" in chats[0]["messages"][0]["content"]
+    with first._icarus.kernel.connect() as store:
+        rows = store.execute("SELECT nonce,state,payload FROM icarus_permits").fetchall()
