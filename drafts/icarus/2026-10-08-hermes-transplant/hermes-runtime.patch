+    with runtime.turn("task", "objective"):
+        request = spec(runtime)
+        permit = runtime.kernel.prepare(request)
+        def attempt(_):
+            kernel = PermitKernel(runtime.kernel.db_path, runtime.identity_hash)
+            try:
+                return kernel.consume(permit, request)
+            except AuthorityDenied:
+                return None
+        with ThreadPoolExecutor(max_workers=8) as pool:
+            results = list(pool.map(attempt, range(8)))
+        assert sum(r is not None for r in results) == 1
+        again = PermitKernel(runtime.kernel.db_path, runtime.identity_hash)
+        with pytest.raises(AuthorityDenied, match="replay"):
+            again.consume(permit, request)
+
+
