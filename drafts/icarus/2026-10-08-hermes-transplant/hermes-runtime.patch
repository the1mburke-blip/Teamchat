@@ -0,0 +1,33 @@
+"""Read the one pinned ICARUS lineage. No model-side constitutional writes."""
+import json
+
+from agent.icarus_authority import current_runtime
+from tools.registry import registry
+
+
+def read_lineage(args, **kwargs):
+    runtime = current_runtime()
+    name = args.get("source", "learned.md")
+    if name not in runtime.lineage:
+        return json.dumps({"error": "Unknown canonical lineage source"})
+    text = runtime.lineage[name]
+    query = args.get("query", "")
+    lines = text.splitlines()
+    if query:
+        indices = {j for i, line in enumerate(lines) if query.casefold() in line.casefold()
+                   for j in range(max(0, i-2), min(len(lines), i+12))}
+        rows = [{"line": i+1, "text": lines[i]} for i in sorted(indices)]
+    else:
+        rows = [{"line": i+1, "text": line} for i, line in enumerate(lines)]
+    return json.dumps({"source": name, "provenance": runtime.provenance.get("sources", {}).get(name, {"kind":"repository", "commit": runtime.provenance["commit"]}),
+                       "sha256": runtime.provenance["files"][name], "rows": rows}, ensure_ascii=False)
+
+
+registry.register(
+    name="icarus_memory", toolset="memory",
+    schema={"name": "icarus_memory", "description": "Read ICARUS canonical identity, inherited memory or training with immutable source provenance. Historical state is not current runtime evidence.",
+            "parameters": {"type": "object", "properties": {
+                "source": {"type": "string", "description": "Exact canonical manifest path, including generational-memory/seed-genome.md and skills/<skill>/SKILL.md"},
+                "query": {"type": "string"}}, "additionalProperties": False}},
+    handler=read_lineage,
+)
