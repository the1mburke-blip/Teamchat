--- /dev/null
+++ b/agent/icarus_runtime.py
@@ -0,0 +1,170 @@
+"""ICARUS ownership inside the donated runtime, never a second agent loop.
+
+Reviewed host modules and administrator-owned state are trusted. Models, tool
+arguments, outputs and container programs are untrusted. No model tool issues
+permits, changes the policy, loads host code, or adjudicates completion.
+"""
+from __future__ import annotations
+
+import contextlib
+import json
+import uuid
+from pathlib import Path
+
+from agent.icarus_authority import (
+    AuthorityDenied, PermitKernel, adapter_scope, canonical, digest, runtime_scope,
+)
+
+SNAPSHOT = Path(__file__).resolve().parent / "icarus_lineage"
+SAFE_TOOLS = frozenset({"icarus_memory", "memory", "todo_list", "terminal", "execute_code", "read_file", "write_file", "patch", "search_files"})
+
+
+def load_lineage():
+    manifest = json.loads((SNAPSHOT / "manifest.json").read_text(encoding="utf-8"))
+    texts = {}
+    import hashlib
+    for name, expected in manifest["files"].items():
+        raw = (SNAPSHOT / name).read_bytes()
+        if hashlib.sha256(raw).hexdigest() != expected:
+            raise AuthorityDenied("ICARUS canonical lineage integrity failure")
+        texts[name] = raw.decode("utf-8")
+    return manifest, texts
+
+
+class IcarusRuntime:
+    def __init__(self, home: Path, session: str):
+        self.home, self.session = Path(home), session
+        self.provenance, self.lineage = load_lineage()
+        self.identity_hash = digest(self.provenance)
+        self.kernel = PermitKernel(self.home / "icarus" / "authority.sqlite", self.identity_hash)
+        self.task = None
+        with self.kernel.connect() as db:
+            db.executescript("""
+                CREATE TABLE IF NOT EXISTS icarus_identity
+                (session TEXT PRIMARY KEY, identity TEXT NOT NULL);
+                CREATE TABLE IF NOT EXISTS icarus_tasks
+                (session TEXT NOT NULL, task TEXT NOT NULL, objective TEXT NOT NULL,
+                 revision INTEGER NOT NULL, PRIMARY KEY(session,task));
+            """)
+            row = db.execute("SELECT identity FROM icarus_identity WHERE session=?", (session,)).fetchone()
+            if row and row[0] != self.identity_hash:
+                raise AuthorityDenied("ICARUS identity changed across restart")
+            db.execute("INSERT OR IGNORE INTO icarus_identity VALUES(?,?)", (session, self.identity_hash))
+
+    @property
+    def identity_prompt(self):
+        return ("ICARUS is the persistent runtime owner. The reasoning model is an untrusted worker for ICARUS. "
+                "The host kernel controls authority and evidence; model prose cannot award PASS.\n\n"
+                + self.lineage["identity.md"] + "\n\nInherited memory (source-linked, historical observations):\n"
+                + self.lineage["inherited.md"] + "\n\n" + self.lineage["learned.md"]
+                + "\n\nCanonical provenance: " + canonical(self.provenance))
+
+    @contextlib.contextmanager
+    def turn(self, task, objective):
+        if self.task is not None:
+            raise AuthorityDenied("ICARUS nested turn denied")
+        if not isinstance(task, str) or not task or not isinstance(objective, str):
+            raise AuthorityDenied("ICARUS task identity missing")
+        objective_hash = digest(objective)
+        with self.kernel.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            row = db.execute("SELECT objective,revision FROM icarus_tasks WHERE session=? AND task=?",
+                             (self.session, task)).fetchone()
+            revision = 1 if not row else row[1] + (row[0] != objective_hash)
+            db.execute("INSERT OR REPLACE INTO icarus_tasks VALUES(?,?,?,?)",
+                       (self.session, task, objective_hash, revision))
+        self.task = dict(task=task, objectiveHash=objective_hash, revision=revision)
+        try:
+            with runtime_scope(self):
+                yield
+        finally:
+            self.task = None
+
+    def request_spec(self, name, args, call):
+        if self.task is None or name not in SAFE_TOOLS or not isinstance(args, dict):
+            raise AuthorityDenied("ICARUS tool outside approved capability catalogue")
+        if name == "terminal":
+            allowed = {"command", "timeout", "workdir", "background", "pty"}
+            if set(args) - allowed or args.get("background") or args.get("pty"):
+                raise AuthorityDenied("ICARUS host/background terminal parameters denied")
+            if not isinstance(args.get("command"), str):
+                raise AuthorityDenied("ICARUS command missing")
+        if name == "execute_code" and set(args) - {"code", "reset"}:
+            raise AuthorityDenied("ICARUS code scope expansion denied")
+        if name == "icarus_memory" and (set(args) - {"source", "query"} or args.get("source", "learned.md") not in self.lineage):
+            raise AuthorityDenied("ICARUS constitutional memory writes denied")
+        if name == "memory":
+            if (set(args) - {"action", "target", "content"} or args.get("action") not in {"read", "add"}
+                    or args.get("target", "memory") != "memory"):
+                raise AuthorityDenied("ICARUS only native observation read/add is approved")
+            if args.get("action") == "add" and not isinstance(args.get("content"), str):
+                raise AuthorityDenied("ICARUS observation content missing")
+        # Every file operation uses the same contained backend, never host I/O.
+        evidence = {"readPath": "sandbox-result:"+self.session+":"+digest(args), "expectedHash": None}
+        if name == "write_file" and isinstance(args.get("content"), str):
+            evidence = {"readPath": "sandbox-file:"+self.session+":"+str(args.get("path")),
+                        "expectedHash": digest(args["content"])}
+        if name == "todo_list" and isinstance(args.get("todos"), list) and not args.get("merge"):
+            evidence = {"readPath": "native-todo:"+self.session, "expectedHash": digest(args["todos"])}
+        return dict(session=self.session, **self.task, call=call, subject="reasoning-worker",
+                    tool=name, argsHash=digest(args), target="session-container:"+self.session,
+                    route="HERMES_DOCKER" if name != "todo_list" else "NATIVE_TODO",
+                    scopes=[name], budgetEUR=0,
+                    evidence=evidence)
+
+    def execute(self, name, args, call, dispatch):
+        spec = self.request_spec(name, args, call or uuid.uuid4().hex)
+        permit = self.kernel.prepare(spec)
+        nonce = self.kernel.consume(permit, spec)
+        from agent.icarus_hooks import invoke
+        try:
+            invoke(self, "pre_tool_call", spec, nonce, args)
+            with runtime_scope(self), adapter_scope(self.kernel, nonce, spec):
+                result = dispatch(args)
+        except BaseException:
+            self.kernel.record_outcome(nonce, uncertain=True)
+            raise
+        try:
+            body = json.loads(result) if isinstance(result, str) else result
+        except (ValueError, TypeError):
+            body = None
+        failed = (not isinstance(body, dict) or body.get("error") or body.get("success") is False
+                  or body.get("status") in {"error", "timeout", "interrupted"}
+                  or body.get("exit_code", 0) != 0)
+        self.kernel.record_outcome(nonce, result, uncertain=bool(failed))
+        try:
+            invoke(self, "post_tool_call", spec, nonce, args)
+        except BaseException:
+            with self.kernel.connect() as db:
+                db.execute("BEGIN IMMEDIATE")
+                db.execute("UPDATE icarus_permits SET state='OUTCOME_UNKNOWN' WHERE nonce=? AND state='WORK_COMPLETE_AWAITING_VERIFICATION'", (nonce,))
+                self.kernel._event(db, "hook.observation_failed", nonce)
+            raise
+        return result
+
+    def describe(self, task):
+        return dict(name="Icarus", identity=self.identity_hash, session=self.session,
+                    task=task, provenance=self.provenance, verdict="FAIL",
+                    reason="Independent final-effect adjudication is required; model output is advisory.")
+
+
+def initialize(agent):
+    from hermes_constants import get_hermes_home
+    if agent._icarus.session != agent.session_id:
+        raise AuthorityDenied("ICARUS session identity mismatch")
+    # Unreviewed memory providers/plugins cannot become a second authority.
+    agent._memory_manager = None
+    from tools.memory_tool import load_on_disk_store
+    agent._memory_store = load_on_disk_store()
+    agent._memory_enabled = True
+    agent._user_profile_enabled = False
+    agent.skip_background_review = True
+    # Approved native tools are eager: a deferred Tool Search bridge must not
+    # hide their schemas or silently regain arbitrary connector authority.
+    from model_tools import _select_tool_names
+    from tools.registry import registry
+    selected = set(_select_tool_names(agent.enabled_toolsets, agent.disabled_toolsets, quiet_mode=True))
+    agent.tools = registry.get_definitions(selected & SAFE_TOOLS, quiet=True)
+    agent.valid_tool_names = {tool["function"]["name"] for tool in agent.tools}
+    from agent.icarus_verifier import bind_todo
+    bind_todo(agent._icarus.kernel, agent.session_id, agent._todo_store)
