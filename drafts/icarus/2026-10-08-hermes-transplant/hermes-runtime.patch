+    assert contract["readPath"] == "native-todo:native-continuity"
+    second = make_agent(url, "processor-b", "native-continuity", db)
+    resumed = second.run_conversation("Finish the proof task", task_id="same-task", conversation_history=result["messages"])
+    assert resumed["icarus"]["identity"] == result["icarus"]["identity"]
+    assert resumed["icarus"]["task"] == "same-task"
+    assert resumed["icarus"]["provenance"] == result["icarus"]["provenance"]
+    assert any(r["model"] == "processor-b" for r in requests if "messages" in r)
+    assert resumed["icarus"]["verdict"] == "FAIL"
