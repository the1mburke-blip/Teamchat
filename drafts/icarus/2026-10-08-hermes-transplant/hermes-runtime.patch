+
+def spec(runtime, call="call-1"):
+    return runtime.request_spec("todo_list", {"todos": [{"id": "x", "content": "done", "status": "completed"}]}, call)
+
+
+def test_canonical_identity_restart_and_task_provenance(runtime):
+    assert "The model is never Icarus" in runtime.identity_prompt
+    assert runtime.lineage["learned.md"].find("ICARUS-ALIVE-001") >= 0
+    assert "HV-EXP-051" in runtime.lineage["training.md"]
+    with runtime.turn("task-stable", "fix it"):
+        before = dict(runtime.task)
+    again = IcarusRuntime(runtime.home, runtime.session)
+    with again.turn("task-stable", "fix it"):
+        assert again.task == before
+    assert again.identity_hash == runtime.identity_hash
+    assert again.provenance == runtime.provenance
+
+
+def test_missing_forged_tampered_expired_authority(runtime):
+    with runtime.turn("task", "objective"):
+        request = spec(runtime)
+        permit = runtime.kernel.prepare(request)
+        for invalid in [None, {}, {"payload": permit["payload"], "signature": "0"*64}]:
+            with pytest.raises(AuthorityDenied):
+                runtime.kernel.consume(invalid, request)
+        changed = copy.deepcopy(permit)
+        changed["payload"]["spec"]["target"] = "other"
+        with pytest.raises(AuthorityDenied):
+            runtime.kernel.consume(changed, request)
+        with pytest.raises(AuthorityDenied):
+            runtime.kernel.consume(permit, dict(request, argsHash=digest({"other": "args"})))
+        short = runtime.kernel.prepare(spec(runtime, "expiry"), ttl=0.001)
+        time.sleep(0.01)
+        with pytest.raises(AuthorityDenied, match="expired"):
+            runtime.kernel.consume(short, spec(runtime, "expiry"))
+
+
+def test_objective_change_revokes_pending_permit(runtime):
+    with runtime.turn("task", "old"):
+        request = spec(runtime)
+        permit = runtime.kernel.prepare(request)
+    with runtime.turn("task", "new"):
+        with pytest.raises(AuthorityDenied, match="objective changed"):
+            runtime.kernel.consume(permit, request)
+
+
