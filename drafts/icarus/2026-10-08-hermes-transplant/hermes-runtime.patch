+
+def create(env_type, image, cwd, timeout, container_config, host_cwd, task_id):
+    current_runtime()
+    cc = container_config or {}
+    unsafe = (env_type != "docker" or image != IMAGE or host_cwd is not None
+              or cc.get("docker_volumes") or cc.get("docker_forward_env") or cc.get("docker_env")
+              or cc.get("docker_extra_args") or cc.get("docker_network", False)
+              or cc.get("container_persistent", False) or cc.get("persistent_filesystem", False) or cc.get("docker_mount_cwd_to_workspace", False) or cc.get("auto_mount_cwd", False)
+              or cc.get("docker_persist_across_processes", False) or cc.get("persist_across_processes", False) or cc.get("shared_container_key")
+              or cc.get("docker_snap_compat", False) or cc.get("snap_compat", False))
+    if unsafe:
+        raise AuthorityDenied("ICARUS sandbox overrides/host execution denied")
+    from tools.environments.docker import DockerEnvironment
