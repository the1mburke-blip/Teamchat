@@ -0,0 +1,52 @@
+"""ICARUS native-permit hook: no primary-profile exemption or hook issuance."""
+from pathlib import Path
+import hashlib, hmac, json, sqlite3, sys, time
+
+PROFILE = Path(__file__).resolve().parent.parent
+class AuthorityDenied(PermissionError):
+    pass
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
+
+def digest(value):
+    return hashlib.sha256(canonical(value).encode()).hexdigest()
+
+
+def validate(payload):
+    if not isinstance(payload, dict) or payload.get("hook_event_name") not in {"pre_tool_call", "post_tool_call"}:
+        raise AuthorityDenied("ICARUS malformed hook request")
+    extra = payload.get("extra", {})
+    nonce = extra.get("icarus_nonce")
+    db_path = PROFILE / "icarus" / "authority.sqlite"
+    if not nonce or not db_path.is_file():
+        raise AuthorityDenied("ICARUS native authority missing")
+    with sqlite3.connect(db_path.as_uri()+"?mode=ro", uri=True) as db:
+        row = db.execute("SELECT payload,signature,state FROM icarus_permits WHERE nonce=?", (nonce,)).fetchone()
+        key_row = db.execute("SELECT key FROM icarus_seal WHERE id=1").fetchone()
+        if not row or not key_row:
+            raise AuthorityDenied("ICARUS unknown permit")
+        key = bytes.fromhex(key_row[0])
+        permit = json.loads(row[0]); spec = permit["spec"]
+        mac = hmac.new(key, canonical(permit).encode(), hashlib.sha256).hexdigest()
+        if not hmac.compare_digest(mac, row[1]) or permit["expiry"] <= time.time():
+            raise AuthorityDenied("ICARUS invalid or expired authority")
+        if (spec["session"] != payload.get("session_id") or spec["task"] != extra.get("task_id")
+                or spec["call"] != extra.get("tool_call_id") or spec["tool"] != payload.get("tool_name")
+                or spec["argsHash"] != digest(payload.get("tool_input"))):
+            raise AuthorityDenied("ICARUS hook request binding mismatch")
+        allowed = {"WORKING"} if payload["hook_event_name"] == "pre_tool_call" else {"WORK_COMPLETE_AWAITING_VERIFICATION", "OUTCOME_UNKNOWN"}
+        if row[2] not in allowed:
+            raise AuthorityDenied("ICARUS hook replay or invalid execution state")
+        return {"action": "allow"} if payload["hook_event_name"] == "pre_tool_call" else {}
+
+def main():
+    try:
+        print(json.dumps(validate(json.load(sys.stdin))))
+        return 0
+    except Exception as exc:
+        print(json.dumps({"action":"block", "message":"ICARUS_DENIED: "+type(exc).__name__+": "+str(exc)}))
+        return 2
+
+if __name__ == "__main__":
+    sys.exit(main())
