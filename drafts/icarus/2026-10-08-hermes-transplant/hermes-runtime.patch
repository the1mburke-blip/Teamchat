@@ -0,0 +1,47 @@
+"""Trusted target reader. Observations come from targets, never supplied hashes.
+
+No tool, RPC, model program or plugin receives this API. Native reads are a
+separate host operation after the execution turn; Docker reads use a separate
+docker-exec process. Administrator-owned Python code remains trusted.
+"""
+import json
+import subprocess
+import weakref
+
+from agent.icarus_authority import AuthorityDenied, digest
+
+_TODOS = {}
+
+
+def bind_todo(kernel, session, store):
+    from tools.todo_tool import TodoStore
+    if type(store) is not TodoStore:
+        raise AuthorityDenied("ICARUS only the reviewed native todo target may bind")
+    _TODOS[(str(kernel.db_path.resolve()), session)] = weakref.ref(store)
+
+
+def observe(kernel, spec, nonce):
+    contract = spec["evidence"]
+    if spec["tool"] == "todo_list" and contract["readPath"] == "native-todo:"+spec["session"]:
+        ref = _TODOS.get((str(kernel.db_path.resolve()), spec["session"]))
+        store = ref() if ref else None
+        if store is None:
+            raise AuthorityDenied("ICARUS actual native target is unavailable")
+        return digest(store.read()), contract["readPath"]
+    if spec["tool"] == "write_file" and contract["readPath"].startswith("sandbox-file:"+spec["session"]+":"):
+        with kernel.connect() as db:
+            row = db.execute("SELECT container FROM icarus_containers WHERE nonce=?", (nonce,)).fetchone()
+        if not row:
+            raise AuthorityDenied("ICARUS physical container target was not bound")
+        path = contract["readPath"].split(":", 2)[2]
+        from tools.environments.docker import find_docker
+        docker = find_docker()
+        if not docker:
+            raise AuthorityDenied("ICARUS Docker readback unavailable")
+        result = subprocess.run(
+            [docker, "exec", row[0], "python3", "-c",
+             "import json,pathlib,sys; print(json.dumps(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8')))", path],
+            capture_output=True, text=True, timeout=15, check=True,
+        )
+        return digest(json.loads(result.stdout)), contract["readPath"]
+    raise AuthorityDenied("ICARUS no reviewed independent reader for this effect")
