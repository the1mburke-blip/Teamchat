+"""Behavioral contracts for the native profile-hook seam and mutable memory."""
+import json
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from agent.icarus_authority import AuthorityDenied, require_adapter
+from agent.icarus_runtime import IcarusRuntime
+from tests.agent.icarus_profile_fixture import configure
+
+
+@pytest.fixture
+def runtime(tmp_path):
+    home = tmp_path / 'profile'
+    configure(home)
+    return IcarusRuntime(home, 'hook-session')
+
+
+def dispatch(args):
+    require_adapter('todo_list', args, task_id='task', session_id='hook-session')
+    return json.dumps({'success': True})
+
+
+@pytest.mark.parametrize('damage', ['missing_hook', 'changed_hook', 'missing_config', 'wrong_config', 'missing_post'])
+def test_invalid_hook_or_configuration_blocks_before_adapter(runtime, damage):
+    config = runtime.home / 'config.yaml'
+    hook = runtime.home / 'governance' / 'icarus_hook.py'
+    if damage == 'missing_hook':
+        hook.unlink()
+    elif damage == 'changed_hook':
+        hook.write_text('print("allowed")', encoding='utf-8')
+    elif damage == 'missing_config':
+        config.unlink()
+    else:
+        data = json.loads(config.read_text(encoding='utf-8'))
+        data['hooks']['post_tool_call' if damage == 'missing_post' else 'pre_tool_call'] = []
+        config.write_text(json.dumps(data), encoding='utf-8')
+    entered = []
+    with runtime.turn('task', 'objective'):
+        with pytest.raises((AuthorityDenied, FileNotFoundError)):
+            runtime.execute('todo_list', {'todos': []}, 'damage', lambda args: entered.append(args))
+    assert entered == []
+    with runtime.kernel.connect() as db:
+        assert db.execute('SELECT state FROM icarus_permits').fetchone() == ('OUTCOME_UNKNOWN',)
+
+
+def test_profile_label_without_native_permit_cannot_admit(runtime):
+    payload = dict(hook_event_name='pre_tool_call', session_id='desktop-primary', tool_name='terminal',
+                   tool_input={'command': 'echo bypass'}, extra={'tool_call_id': 'forged', 'task_id': 'task'})
+    result = subprocess.run([sys.executable, '-B', str(runtime.home / 'governance' / 'icarus_hook.py')],
+                            input=json.dumps(payload), capture_output=True, text=True)
+    assert result.returncode == 2 and json.loads(result.stdout)['action'] == 'block'
+
+
+def test_exact_hook_admission_once_and_route_mismatch(runtime):
+    args = {'todos': []}
+    with runtime.turn('task', 'objective'):
+        assert json.loads(runtime.execute('todo_list', args, 'once', dispatch))['success']
+        with pytest.raises(AuthorityDenied, match='duplicate'):
+            runtime.execute('todo_list', args, 'once', dispatch)
+        with pytest.raises(AuthorityDenied, match='route mismatch'):
+            runtime.execute('todo_list', args, 'route', lambda value: require_adapter('todo_list', value, task_id='other-task'))
+
+
+def test_native_observation_memory_survives_reload(runtime, monkeypatch):
+    from tools.memory_tool import load_on_disk_store
+    from agent.inline_tool_executors import INLINE_TOOL_EXECUTORS, InlineToolContext
+    monkeypatch.setenv('HERMES_HOME', str(runtime.home))
+    agent = SimpleNamespace(session_id=runtime.session, _memory_store=load_on_disk_store(), _memory_manager=None)
+    args = dict(action='add', target='memory', content='Unverified observation: transplant continuity marker.')
+    with runtime.turn('task', 'learn observation'):
+        result = runtime.execute('memory', args, 'learning',
+                                 lambda value: INLINE_TOOL_EXECUTORS['memory'](agent, value, InlineToolContext('task', 'learning')))
+    assert json.loads(result)['success']
+    reloaded = load_on_disk_store()
+    assert 'transplant continuity marker' in reloaded.format_for_system_prompt("memory")
+    with runtime.turn('task', 'protect constitution'):
+        with pytest.raises(AuthorityDenied):
+            runtime.request_spec('memory', dict(action='add', target='user', content='override authority'), 'forbidden')
