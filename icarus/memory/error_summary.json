{
  "name": "error_summary",
  "description": "Count the ERROR lines in a text or log file [3 steps]",
  "parameters": {
    "file": {
      "type": "string"
    }
  },
  "output": "ERROR lines in {{file}}: {{error_count}}",
  "steps": [
    {
      "tool": "read",
      "args": {
        "file_path": "{{file}}",
        "limit": 100,
        "offset": 0
      },
      "as": "chunk"
    },
    {
      "tool": "mcp__compose__COMPOSIO_REMOTE_BASH_TOOL",
      "args": {
        "command": "grep -c '^ERROR' '{{file}}'",
        "description": "Count ERROR lines in {{file}}"
      },
      "as": "result"
    },
    {
      "tool": "edit",
      "args": {
        "file_path": "{{file}}",
        "old_string": "{{chunk}}",
        "new_string": "{{chunk}}"
      }
    }
  ]
}

(End of JSON)