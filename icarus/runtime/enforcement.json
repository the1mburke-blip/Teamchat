{
  "_note": "Owner-editable enforcement limits read by icarus_run.py (looser = raise numbers, tighter = lower). Defaults apply if a key is missing. Hard stops end the run with FAIL and a receipt; they are never silently retried.",
  "dailyRunCap": 60,
  "maxApiCallsPerRun": 24,
  "maxRuntimeSeconds": 3000,
  "verifyUrlHosts": [
    "github.com",
    "raw.githubusercontent.com",
    "api.github.com"
  ],
  "riskyActionPattern": "\\b(publish|post to|send (?:an? )?(?:email|message|dm)|delete|purchase|buy|pay|transfer|deploy|force.push|wipe)\\b",
  "tools": [
    "read_file",
    "list_dir",
    "read_issue",
    "write_issue_comment"
  ],
  "maxToolCalls": 6,
  "maxPlanSteps": 4,
  "readPathPrefixes": [
    "icarus/",
    ".github/workflows/",
    "README.md"
  ],
  "writeBack": true
}
